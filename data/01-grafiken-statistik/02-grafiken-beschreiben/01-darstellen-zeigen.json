        "type": "rfn",
        "prompt": "An der Erhebung nahmen 2000 Personen teil.",
        "answer": "richtig"
      },
      {
        "type": "rfn",
        "prompt": "Die meisten Befragten lesen täglich eine gedruckte Zeitung.",
        "answer": "falsch"
      },
      {
        "type": "mc",
        "prompt": "Was stellen die Forscher fest?",
        "options": [
          "Ältere nutzen häufiger soziale Netzwerke.",
          "Jüngere nutzen häufiger soziale Netzwerke.",
          "Alle nutzen gleich oft soziale Netzwerke."
        ],
        "answer": 1
      },
      {
        "type": "rfn",
        "prompt": "Die Befragung wurde vom Bildungsministerium bezahlt.",
        "answer": "nicht_im_text"
      }
    ]
  }
