  "text": {
    "id": "wasserverbrauch",
    "title": "Wie viel Wasser brauchen wir?",
    "paragraphs": [
      "Der durchschnittliche Wasserverbrauch pro Person liegt in Deutschland heute bei rund 125 Litern am Tag. 1990 betrug der Wert noch knapp 150 Liter. Insgesamt ist die Menge also deutlich gesunken, vor allem wegen sparsamer Waschmaschinen und Toiletten.",
      "Im Sommer kann der Verbrauch aber stark steigen. Im heißen Sommer 2022 überstieg die Nachfrage in einigen Gemeinden sogar das Angebot. Dort wurde ein neuer Rekord verzeichnet, und die Wasserwerke baten die Menschen, keine Gärten mehr zu bewässern.",
      "Viele Leitungen sind alt und müssen erneuert werden. Die Kosten dafür belaufen sich nach dem aktuellen Stand auf mehrere Milliarden Euro."
    ],
    "uses": ["liegen", "rund", "betragen", "der-wert", "knapp", "insgesamt", "die-menge", "uebersteigen", "der-rekord", "verzeichnen", "sich-belaufen", "der-stand"],
    "questions": [
      { "type": "rfn", "prompt": "Heute verbraucht eine Person in Deutschland weniger Wasser als 1990.", "answer": "richtig" },
      { "type": "rfn", "prompt": "Im Sommer 2022 gab es in allen Gemeinden zu wenig Wasser.", "answer": "falsch" },
      { "type": "rfn", "prompt": "Wasser ist in Deutschland teurer als in den Nachbarländern.", "answer": "nicht_im_text" },
      { "type": "mc", "prompt": "Wie hoch war der Verbrauch pro Person im Jahr 1990?", "options": ["etwas mehr als 150 Liter", "etwas weniger als 150 Liter", "genau 125 Liter"], "answer": 1 }
    ]
  }
