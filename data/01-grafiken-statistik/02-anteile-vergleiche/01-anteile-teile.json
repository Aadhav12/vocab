        "type": "rfn",
        "prompt": "Für das Wohnen geben Studierende mehr als ein Drittel ihres Geldes aus.",
        "answer": "richtig"
      },
      {
        "type": "rfn",
        "prompt": "Die meisten Studierenden bekommen ein Stipendium.",
        "answer": "falsch"
      },
      {
        "type": "rfn",
        "prompt": "Studierende in München arbeiten mehr Stunden pro Woche als in anderen Städten.",
        "answer": "nicht_im_text"
      },
      {
        "type": "mc",
        "prompt": "Wie hat sich der Anteil der Stipendiaten seit 2016 entwickelt?",
        "options": [
          "Er ist um zwei Prozent gesunken.",
          "Er ist um zwei Prozentpunkte gestiegen.",
          "Er ist gleich geblieben."
        ],
        "answer": 1
      }
    ]
  }
