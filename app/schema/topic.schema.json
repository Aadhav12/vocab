{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "topic.schema.json",
  "title": "Topic file",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "topicGroup": {
      "type": "string",
      "minLength": 1,
      "description": "Heading this topic is listed under on the overview. Topics with the same name share one heading; headings appear in the order of their first topic."
    }
  }
}
