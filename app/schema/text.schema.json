{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "text.schema.json",
  "title": "Reading text",
  "type": "object",
  "required": [
    "id",
    "title",
    "paragraphs",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "prompt",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "rfn"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "enum": [
                  "richtig",
                  "falsch",
                  "nicht_im_text"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "prompt",
              "options",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "mc"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "paragraph",
              "options",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "heading"
              },
              "paragraph": {
                "type": "integer",
                "minimum": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  }
}